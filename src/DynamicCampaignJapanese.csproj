<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DynamicCampaignJapanese</AssemblyName>
    <RootNamespace>DynamicCampaignJapanese</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="MonoMod.Utils" HintPath="$(SeaPowerDir)\BepInEx\core\MonoMod.Utils.dll" Private="false" />
    <Reference Include="Mono.Cecil" HintPath="$(SeaPowerDir)\BepInEx\core\Mono.Cecil.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SeaPowerDir)' == ''" Text="Set SeaPowerDir in Directory.Build.local.props. Copy Directory.Build.local.props.example to get started." />
    <Error Condition="'$(AnchorChainDir)' == ''" Text="Set AnchorChainDir in Directory.Build.local.props. Copy Directory.Build.local.props.example to get started." />
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="Anchor Chain DLL not found. Check AnchorChainDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\0Harmony.dll')" Text="Harmony DLL not found. Check SeaPowerDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\BepInEx.dll')" Text="BepInEx DLL not found. Check SeaPowerDir in Directory.Build.local.props." />
    <Error Condition="!Exists('$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll')" Text="Newtonsoft.Json DLL not found. Check SeaPowerDir in Directory.Build.local.props." />
  </Target>
</Project>
