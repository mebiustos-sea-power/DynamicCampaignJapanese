<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>DynamicCampaignJapanese</AssemblyName>
    <RootNamespace>DynamicCampaignJapanese</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AnchorChain" HintPath="$(AnchorChainDir)\AnchorChain.dll" Private="false" />
    <Reference Include="BepInEx" HintPath="$(SeaPowerDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(SeaPowerDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(SeaPowerDir)\Sea Power_Data\Managed\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AnchorChainDir)\AnchorChain.dll')" Text="Anchor Chain DLL not found. Set AnchorChainDir to its installed directory." />
    <Error Condition="!Exists('$(SeaPowerDir)\BepInEx\core\0Harmony.dll')" Text="Harmony DLL not found. Set SeaPowerDir to the installed game directory." />
  </Target>
</Project>
